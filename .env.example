# Environment variables (copy to `.env` — never commit `.env`)

NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SECRET_KEY=sb_secret_...

# stub (local) | meta (production WhatsApp Cloud API)
WHATSAPP_PROVIDER=stub
WHATSAPP_API_KEY=
WHATSAPP_WEBHOOK_SECRET=

# Optional: used by `pnpm db:seed`
SEED_OWNER_EMAIL=demo@ungane.local
SEED_OWNER_PASSWORD=DemoPass123!
SEED_BUSINESS_NAME=Spa Lumière Demo
